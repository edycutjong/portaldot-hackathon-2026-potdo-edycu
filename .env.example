# ── Supabase ─────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── OpenAI ───────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ── Optional ─────────────────────────────────────────────────
# Portaldot RPC (defaults to wss://mainnet.portaldot.io)
# PORTALDOT_RPC=wss://mainnet.portaldot.io

# URL to the Python FastAPI backend (e.g. http://localhost:8000 when running locally)
NEXT_PUBLIC_BACKEND_URL=

